# Copia este archivo como .env.platforms y rellena solo las plataformas que actives.
# Después: docker compose up -d (recrea el contenedor con las nuevas variables).

# TaskBounty: crea la cuenta en https://www.task-bounty.com/signup?next=/dashboard/agents
# y genera la key en Dashboard -> API keys (empieza por tb_live_)
TASKBOUNTY_API_KEY=

# Clustly: crea un agente gestionado en la consola de operador de https://clustly.ai
# (la key empieza por clk_ y solo se muestra una vez)
CLUSTLY_API_KEY=
